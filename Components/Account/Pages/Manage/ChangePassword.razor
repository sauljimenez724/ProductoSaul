@page "/Account/Manage/ChangePassword"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using ProductoSaul.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ChangePassword> Logger

<PageTitle>Cambiar contraseña</PageTitle> <!-- Título de la página -->

<h3>Cambiar contraseña</h3> <!-- Encabezado principal -->
<StatusMessage Message="@message" />
<div class="row">
    <div class="col-md-6">
        <EditForm Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator /> <!-- Validador para las anotaciones de datos -->
            <ValidationSummary class="text-danger" role="alert" /> <!-- Muestra resumen de errores -->
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Ingrese su contraseña actual." />
                <label for="old-password" class="form-label">Contraseña actual</label>
                <ValidationMessage For="() => Input.OldPassword" class="text-danger" />
            </div>

            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Ingrese su nueva contraseña." />
                <label for="new-password" class="form-label">Nueva contraseña</label>
                <ValidationMessage For="() => Input.NewPassword" class="text-danger" />
            </div>

            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirme su nueva contraseña." />
                <label for="confirm-password" class="form-label">Confirmar nueva contraseña</label>
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-primary">Actualizar contraseña</button>
        </EditForm>
    </div>
</div>

@code {
    private string? message; // Mensaje de estado para errores o confirmaciones
    private ApplicationUser user = default!; // Usuario autenticado actual
    private bool hasPassword; // Indica si el usuario ya tiene una contraseña configurada

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!; // Contexto HTTP actual

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new(); // Modelo para enlazar los datos del formulario

    // Inicialización del componente
    protected override async Task OnInitializedAsync()
    {
        // Obtiene el usuario actual
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);

        // Verifica si el usuario tiene una contraseña configurada
        hasPassword = await UserManager.HasPasswordAsync(user);

        // Redirige si no tiene una contraseña configurada
        if (!hasPassword)
        {
            RedirectManager.RedirectTo("Account/Manage/SetPassword");
        }
    }

    // Acción al enviar el formulario
    private async Task OnValidSubmitAsync()
    {
        // Intenta cambiar la contraseña del usuario
        var changePasswordResult = await UserManager.ChangePasswordAsync(user, Input.OldPassword, Input.NewPassword);
        if (!changePasswordResult.Succeeded)
        {
            // Muestra los errores si el cambio de contraseña falla
            message = $"Error: {string.Join(",", changePasswordResult.Errors.Select(error => error.Description))}";
            return;
        }

        // Refresca la sesión del usuario
        await SignInManager.RefreshSignInAsync(user);
        Logger.LogInformation("El usuario cambió su contraseña exitosamente.");

        // Redirige a la página actual con un mensaje de éxito
        RedirectManager.RedirectToCurrentPageWithStatus("Tu contraseña ha sido cambiada", HttpContext);
    }

    // Modelo para los datos del formulario
    private sealed class InputModel
    {
        [Required]
        [DataType(DataType.Password)]
        [Display(Name = "Contraseña actual")]
        public string OldPassword { get; set; } = ""; // Contraseña actual

        [Required]
        [StringLength(100, ErrorMessage = "La {0} debe tener al menos {2} y máximo {1} caracteres.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        [Display(Name = "Nueva contraseña")]
        public string NewPassword { get; set; } = ""; // Nueva contraseña

        [DataType(DataType.Password)]
        [Display(Name = "Confirmar nueva contraseña")]
        [Compare("NewPassword", ErrorMessage = "La nueva contraseña y la confirmación no coinciden.")]
        public string ConfirmPassword { get; set; } = ""; // Confirmación de la nueva contraseña
    }
}
