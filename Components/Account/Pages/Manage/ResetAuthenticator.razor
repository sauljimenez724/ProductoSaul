@page "/Account/Manage/ResetAuthenticator"

@using Microsoft.AspNetCore.Identity
@using ProductoSaul.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ResetAuthenticator> Logger

<PageTitle>Restablecer clave de autenticación</PageTitle> 
<StatusMessage /> 
<h3>Restablecer clave de autenticación</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>Si restableces tu clave de autenticación, tu aplicación autenticadora no funcionará hasta que la reconfigures.</strong>
    </p>
    <p>
        Este proceso desactiva la autenticación de dos factores (2FA) hasta que verifiques tu aplicación autenticadora.
        Si no completas la configuración de tu aplicación, podrías perder acceso a tu cuenta.
    </p>
</div>
<div>
    <form @formname="reset-authenticator" @onsubmit="OnSubmitAsync" method="post">
        <AntiforgeryToken /> <!-- Protección contra ataques CSRF -->
        <button class="btn btn-danger" type="submit">Restablecer clave de autenticación</button>
    </form>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!; // Contexto HTTP actual

    // Acción al enviar el formulario para restablecer la clave de autenticación
    private async Task OnSubmitAsync()
    {
        var user = await UserAccessor.GetRequiredUserAsync(HttpContext); // Obtiene el usuario autenticado actual

        // Desactiva la autenticación de dos factores (2FA) y restablece la clave de autenticación
        await UserManager.SetTwoFactorEnabledAsync(user, false);
        await UserManager.ResetAuthenticatorKeyAsync(user);

        // Registra el evento en los logs
        var userId = await UserManager.GetUserIdAsync(user);
        Logger.LogInformation("El usuario con ID '{UserId}' ha restablecido la clave de su aplicación autenticadora.", userId);

        // Refresca la sesión del usuario
        await SignInManager.RefreshSignInAsync(user);

        // Redirige al usuario a la página para reconfigurar la aplicación autenticadora con un mensaje de estado
        RedirectManager.RedirectToWithStatus(
            "Account/Manage/EnableAuthenticator",
            "La clave de tu aplicación autenticadora ha sido restablecida. Necesitarás configurar tu aplicación nuevamente usando la nueva clave.",
            HttpContext);
    }
}
