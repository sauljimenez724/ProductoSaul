@page "/Account/Manage/SetPassword"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using ProductoSaul.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager

<PageTitle>Establecer contraseña</PageTitle> 
<h3>Establecer tu contraseña</h3> 
<StatusMessage Message="@message" /> 
<p class="text-info">
    No tienes un nombre de usuario/contraseña local para este sitio. Agrega una cuenta local para poder iniciar sesión sin un inicio de sesión externo.
</p>

<div class="row">
    <div class="col-md-6">
        <EditForm Model="Input" FormName="set-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator /> <!-- Validador para las anotaciones de datos -->
            <ValidationSummary class="text-danger" role="alert" /> <!-- Muestra resumen de errores -->
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.NewPassword" class="form-control" autocomplete="new-password" placeholder="Por favor, introduce tu nueva contraseña." />
                <label for="new-password" class="form-label">Nueva contraseña</label>
                <ValidationMessage For="() => Input.NewPassword" class="text-danger" />
            </div>

            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Por favor, confirma tu nueva contraseña." />
                <label for="confirm-password" class="form-label">Confirmar contraseña</label>
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-primary">Establecer contraseña</button>
        </EditForm>
    </div>
</div>

@code {
    private string? message; // Mensaje de estado para errores o confirmaciones
    private ApplicationUser user = default!; // Usuario autenticado actual

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!; // Contexto HTTP actual

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new(); // Modelo para enlazar los datos del formulario

    // Inicialización del componente
    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext); // Obtiene el usuario autenticado actual

        // Redirige al usuario a la página de cambio de contraseña si ya tiene una configurada
        var hasPassword = await UserManager.HasPasswordAsync(user);
        if (hasPassword)
        {
            RedirectManager.RedirectTo("Account/Manage/ChangePassword");
        }
    }

    // Acción al enviar el formulario para establecer la contraseña
    private async Task OnValidSubmitAsync()
    {
        // Intenta agregar la nueva contraseña al usuario
        var addPasswordResult = await UserManager.AddPasswordAsync(user, Input.NewPassword!);
        if (!addPasswordResult.Succeeded)
        {
            message = $"Error: {string.Join(",", addPasswordResult.Errors.Select(error => error.Description))}";
            return;
        }

        await SignInManager.RefreshSignInAsync(user); // Refresca la sesión del usuario
        RedirectManager.RedirectToCurrentPageWithStatus("Tu contraseña ha sido establecida.", HttpContext); // Redirige con un mensaje de éxito
    }

    // Modelo para los datos del formulario
    private sealed class InputModel
    {
        [Required]
        [StringLength(100, ErrorMessage = "La {0} debe tener al menos {2} y un máximo de {1} caracteres.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        [Display(Name = "Nueva contraseña")]
        public string? NewPassword { get; set; } // Nueva contraseña ingresada por el usuario

        [DataType(DataType.Password)]
        [Display(Name = "Confirmar nueva contraseña")]
        [Compare("NewPassword", ErrorMessage = "La nueva contraseña y la confirmación no coinciden.")]
        public string? ConfirmPassword { get; set; } // Confirmación de la nueva contraseña
    }
}
