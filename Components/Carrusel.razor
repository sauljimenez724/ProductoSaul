@rendermode InteractiveServer
<p>
    Estas son imagenes del curso basico de html en forma de carrusel .
</p>
<div class="row">
<div class="col-sm-12 col-md-6">
<div id="carouselExample" class="carousel slide">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="Imagenes/PersonaconParlante.jpg" class="d-block w-50" alt="Persona con parlante .">
        </div>
        <div class="carousel-item">
                    <img src="Imagenes/Fundamentosbasicos.jpg" class="d-block w-50" alt="Conceptos básicos ." />
        </div>
        <div class="carousel-item">
                    <img alt="Proyecto final del curso ." class="d-block w-50" src="Imagenes/ProyectoWebfinal.jpg" />
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Anterior</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Siguiente</span>
    </button>
</div>
</div>
</div>