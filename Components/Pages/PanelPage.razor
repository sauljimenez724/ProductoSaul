@page "/paneladministracion"
@using Microsoft.AspNetCore.Authorization
@inject IPersonaServices getPersonaservice
@attribute [StreamRendering]
@attribute [Authorize(Roles = "Administrador")]
<PageTitle>Panel de administración</PageTitle>
<h1 class="text-center">Panel de Administración</h1>
<div class="container">
@if (personaEntities == null)
{
    <p class="text-danger text-center">
        Error al cargar usuarios.
    </p>
}
else if (personaEntities.Count == 0)
{
    <p class="text-warning text-center">
        No hay usuarios registrados.
    </p>
}
else
{
<ol type="I">
<li>@usuarios</li>
</ol>
    <table class="table table-hover table-bordered table-dark" style="font-size: 2rem;">
<caption>
    Usuarios
</caption>
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Apellidos</th>
                <th>Email</th>
                <th>WhatsApp</th>
            <th>Eliminar</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var persona in personaEntities)
            {
                <tr>
                    <td>@persona.AlumnoId</td>
                    <td>@persona.Nombre</td>
                    <td>@persona.Apellidos</td>
                    <td>@persona.Correo</td>
                    <td>@persona.TelefonoWhatsapp</td>
                <td>
                    <a href="persona/eliminar/@persona.AlumnoId">Eliminar el alumno @persona.Nombre</a>
                </td>
                </tr>
            }
        </tbody>
    </table>
}
</div>

                @code{
    List<PersonaEntity> personaEntities = new();
    string usuarios 	=>
        personaEntities.Count == 1 ? "Hay un Usuario registrado ." : $"Hay {personaEntities.Count} usuarios registrados .";
    
        protected override async Task OnInitializedAsync()
    {
        var resultadoPersona = await getPersonaservice.ListaPersonaAsync();
        if (resultadoPersona != null)
        {
            personaEntities = resultadoPersona;
        }
    }

                }